.wrap { padding: 24rpx 28rpx 60rpx; }
.cover {
  background: radial-gradient(circle at 30% 25%, #4a76ff, #1e2b45 75%);
  border-radius: 28rpx; padding: 32rpx; color: #fff; height: 300rpx;
  display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box;
}
.ctag { font-size: 22rpx; color: #c6d4ff; letter-spacing: 2rpx; }
.ctitle { font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.bars { display: flex; align-items: flex-end; height: 40rpx; }
.bars text {
  width: 8rpx; background: rgba(255,255,255,.75); border-radius: 4rpx; margin-left: 6rpx;
  height: 40%; animation: eq 1.1s infinite ease-in-out;
}
.bars text:nth-child(2) { animation-delay: .12s; }
.bars text:nth-child(3) { animation-delay: .24s; }
.bars text:nth-child(4) { animation-delay: .36s; }
.bars text:nth-child(5) { animation-delay: .48s; }
.bars.paused text { animation-play-state: paused; height: 30%; }
@keyframes eq { 0%, 100% { height: 25%; } 50% { height: 100%; } }

.clock { font-size: 56rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.bar { height: 10rpx; background: #ecebe6; border-radius: 999rpx; overflow: hidden; margin-top: 20rpx; }
.bar-in { height: 100%; background: linear-gradient(90deg, #2f5fe0, #7b9bff); transition: width .4s; }

.obj { font-size: 27rpx; color: #2b3440; line-height: 1.7; }
.script { max-height: 900rpx; overflow-y: auto; }
.para { font-size: 29rpx; line-height: 2; color: #2b3440; margin-bottom: 24rpx; }
