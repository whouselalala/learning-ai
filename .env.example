# ---------- 服务 ----------
PORT=8787
DATA_DIR=./data
DB_FILE=./data/app.db
MEDIA_DIR=./data/media
TOKEN_SECRET=请替换为随机 32 位以上字符串
ADMIN_SECRET=请替换为运营后台密钥

# ---------- DeepSeek ----------
# 不填也能跑：会自动进入离线 Mock 模式，用于本地演示与自动化测试
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=60000

# ---------- 微信小程序 ----------
WX_APPID=
WX_SECRET=

# ---------- 支付（企业商户号，结算到公司对公账户） ----------
# 留空自动判断：配齐下面参数就用 wechat，否则 mock（仅演示；生产会拒绝启动）
# 详见 docs/07-微信支付与对公收款.md
PAY_PROVIDER=
# 虚拟支付道具直购：PAY_PROVIDER=virtual
# 0 为现网，1 为沙箱。价格以分为单位，必须和微信后台的商品价格一致。
VIRTUAL_PAY_ENV=1
VIRTUAL_PAY_OFFER_ID=
VIRTUAL_PAY_APP_KEY_SANDBOX=
VIRTUAL_PAY_APP_KEY_PROD=
VIRTUAL_PAY_PRODUCTS_JSON={}
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_APIV3_KEY=
WXPAY_PLATFORM_PUBLIC_KEY_PATH=./certs/wechatpay_public_key.pem
WXPAY_PLATFORM_PUBLIC_KEY_ID=
WXPAY_NOTIFY_URL=https://api.example.com/api/pay/notify
PAY_ORDER_TTL_SEC=7200

# ---------- 试用与计费 ----------
TRIAL_SECONDS=3600          # 60 分钟免费体验（按秒累计，不按次重置）
PRICE_FEN_PER_MINUTE=80     # 会员 0.8 元/分钟 = 80 分/分钟

# ---------- 推荐佣金 ----------
# cycle：每 3 个达标会员为一轮（第1个20%、第2个50%、第3个70%，第4个重新回到20%…）
# depth：按推荐层级（直推20%、二级50%、三级及以后70%）
# sequence：按第几个会员递增，到70%后不回落（旧口径）
REFERRAL_MODE=cycle
REFERRAL_LADDER_BP=[2000,5000,7000]   # 每轮内第 1/2/3 个达标会员的比例（万分比）
REFERRAL_QUALIFY_FEN=5000   # 累计消费满 50 元才计入序号；设 0 表示首单即计入
REFERRAL_CAP_TOTAL_BP=10000  # 单笔消费的佣金总额上限（100%），防止平台倒贴
COMMISSION_SETTLE_DAYS=7     # T+7 才可提现，留出退款窗口

# ---------- 语音合成 ----------
# sapi：使用本机 Windows 语音（开发演示）
# http：调用自建/云厂商 TTS（生产推荐，如火山引擎、阿里云、Azure）
TTS_PROVIDER=sapi
TTS_VOICE=Microsoft Huihui Desktop
TTS_HTTP_URL=
TTS_HTTP_KEY=
